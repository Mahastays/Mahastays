type Attraction {
  name     String
  distance String?
  time     String?
}

type RatingBreakdown {
  cleanliness   Float @default(0)
  accuracy      Float @default(0)
  communication Float @default(0)
  location      Float @default(0)
  checkIn       Float @default(0)
  value         Float @default(0)
}

// ── Catalog: packages ────────────────────────────────────────────────────────
type FreeActivity {
  experienceId String? @db.ObjectId
  name         String
  time         String?
  image        String?
  category     String?
}

type Inclusion {
  title String
  desc  String?
  icon  String?
}

type ItineraryDay {
  day        Int
  title      String
  activities String[]
  meals      String?
  stay       String?
  image      String?
}

type PackageTier {
  tierId         String
  name           String
  badge          String?
  tagline        String?
  hotelType      String?
  pricePerPerson Int
  originalPrice  Int?
