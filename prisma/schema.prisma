// ─────────────────────────────────────────────────────────────────────────────
//  Mahastays — Prisma schema (MongoDB)
//
//  Notes for MongoDB + Prisma 6:
//   • MongoDB MUST run as a replica set (Prisma uses transactions internally).
//     docker-compose.yml in this repo starts a single-node replica set.
//   • `@unique` on an OPTIONAL field is avoided on purpose: Prisma creates a
//     NON-sparse unique index, so only one document could ever lack the field.
//     Optional-but-unique fields (phone.nationalNumber, Payment.invoiceNumber,
//     Payment.gatewayPaymentId, ...) get partial unique indexes from
//     `npm run db:indexes` (scripts/create-indexes.ts).
//   • Money counters that need atomic `increment` (vendor wallet, ad counters,
//     user metrics, review votes) are TOP-LEVEL fields, not embedded documents.
//     The API presenters re-nest them to match the documented response shapes.
//   • Prisma 7 has no MongoDB connector, so this project pins Prisma 6.19.x.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

