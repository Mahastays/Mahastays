// ═════════════════════════════════════════════════════════════════════════════
//  COMPOSITE TYPES (embedded documents)
// ═════════════════════════════════════════════════════════════════════════════

// ── Users ────────────────────────────────────────────────────────────────────
type Phone {
  countryCode    String
  nationalNumber String
  isVerified     Boolean @default(false)
}

type Membership {
  isClubMember Boolean        @default(false)
  tier         MembershipTier @default(standard)
  joinedAt     DateTime?
  expiresAt    DateTime?
}

type UserPreferences {
  preferredLanguage String  @default("en")
  currency          String  @default("INR")
  dietaryPreference String? // "veg" | "non-veg" | "jain" | "vegan"
}

type UserVerification {
  isEmailVerified          Boolean @default(false)
  isPhoneVerified          Boolean @default(false)
  governmentIdType         String? // "aadhaar" | "passport" | "driving_license"
  governmentIdNumberMasked String?
  isIdVerified             Boolean @default(false)
}

// ── Vendors ──────────────────────────────────────────────────────────────────
type PostalAddress {
  addressLine1 String
  city         String
  district     String?
  state        String
  pincode      String
  country      String  @default("India")
}

type VendorContact {
  primaryContactPerson    String
  alternatePhone          String?
  registeredOfficeAddress PostalAddress
}

type VendorCompliance {
  panNumber            String
  gstin                String?
  tourismLicenseNumber String?
  identityProofUrl     String?
  businessProofUrl     String?
  verificationStatus   VerificationStatus @default(pending)
  rejectionReason      String?
  verifiedAt           DateTime?
  verifiedByAdminId    String?            @db.ObjectId
}

type VendorBanking {
  accountHolderName  String
  accountNumberEnc   String // AES-256-GCM ciphertext (see utils/crypto.ts)
  accountNumberLast4 String
  bankName           String
  ifscCode           String
  branchName         String?
  upiId              String?
  isAccountVerified  Boolean @default(false)
}

type CommissionTerms {
  commissionType                  CommissionType @default(percentage)
  propertyCommissionRatePercent   Float
  packageCommissionRatePercent    Float
  experienceCommissionRatePercent Float
  payoutCycle                     PayoutCycle    @default(monthly)
}

// ── Staff ────────────────────────────────────────────────────────────────────
type SubAdminPermissions {
  canViewBookings                 Boolean @default(true)
  canInitiateCustomerRefunds      Boolean @default(false)
  maxRefundCeilingInr             Int     @default(0)
  canApproveReviews               Boolean @default(false)
  canFlagFraudulentListings       Boolean @default(false)
  canManageInquiryTickets         Boolean @default(true)
  canViewVendorBankDetails        Boolean @default(false)
  canEditListingDescriptions      Boolean @default(false)
  canTriggerCustomerNotifications Boolean @default(false)
}

type AdminPermissions {
  canApproveVendors              Boolean @default(false)
  canApproveProperties           Boolean @default(false)
  canApprovePackages             Boolean @default(false)
  canApproveExperiences          Boolean @default(false)
  canApproveAdCampaigns          Boolean @default(false)
  canProcessOverridesAndDisputes Boolean @default(false)
  canManageSubAdmins             Boolean @default(false)
  canExportFinancialReports      Boolean @default(false)
  canBlockListings               Boolean @default(false)
}

type StaffSecurity {
  isTwoFactorEnabled  Boolean  @default(false)
  twoFactorSecretEnc  String?
  allowedIpWhitelists String[]
}

// ── Platform configuration ───────────────────────────────────────────────────
type GstRates {
  staysStandardGstPercent Float @default(18)
  packagesGstPercent      Float @default(5)
  experiencesGstPercent   Float @default(5)
}

type PlatformFees {
  defaultCleaningFeeRatePercent      Float @default(5)
  defaultGearInsuranceFeeRatePercent Float @default(4)
  clubMemberDiscountPercent          Float @default(8)
  packageChildPricePercent           Float @default(60)
  experienceChildPricePercent        Float @default(70)
}

type CancellationRules {
  defaultFreeCancellationHours Int   @default(48)
  lateCancellationFeePercent   Float @default(50)
}

type DefaultCommission {
  propertyCommissionRatePercent   Float       @default(12)
  packageCommissionRatePercent    Float       @default(10)
  experienceCommissionRatePercent Float       @default(15)
  payoutCycle                     PayoutCycle @default(monthly)
}

type PayoutRules {
  tdsRatePercent       Float @default(1)
  minPayoutAmountInr   Int   @default(1000)
  holdDaysAfterService Int   @default(2)
}

type DynamicPricingRules {
  enabled      Boolean  @default(false)
  holidayDates String[] // "YYYY-MM-DD"
}

