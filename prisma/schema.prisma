}

type PackagePricingRules {
  basePrice        Int
  pricePerPerson   Int?
  weekendSurcharge Int  @default(0)
  childPrice       Int?
  minGuests        Int  @default(1)
  maxGuests        Int
}

// ── Catalog: experiences ─────────────────────────────────────────────────────
type TimelineItem {
  time  String
  title String
  desc  String?
}

type Coordinates {
  lat Float
  lng Float
}

type ExperienceSchedule {
  mode          ScheduleMode @default(fixed_slot)
  daysAvailable String[] // "all" | "mon" | "tue" | "wed" | "thu" | "fri" | "sat" | "sun"
}

type ExperienceSlot {
  slotId   String
  time     String
  label    String
  capacity Int
  price    Int?
}

type ExperienceTier {
  tierId         String
  name           String
  tagline        String?
  pricePerPerson Int
